{
  "name": "@warppay402/sdk",
  "version": "1.1.8",
  "license": "MIT",
  "description": "Official WarpPay402 TypeScript SDK: Enabling seamless pay-per-use AI tools across Base Mainnet, Solana, and Arbitrum One.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external viem,@solana/web3.js,@solana/spl-token",
    "prepublishOnly": "npm run build",
    "version": "node -e \"const fs = require('fs'); const p = JSON.parse(fs.readFileSync('openclaw.plugin.json')); p.version = process.env.npm_package_version; fs.writeFileSync('openclaw.plugin.json', JSON.stringify(p, null, 2) + '\\n');\" && git add openclaw.plugin.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warppay402/warppay402-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Warppay402/warppay402-sdk/issues"
  },
  "homepage": "https://github.com/Warppay402/warppay402-sdk#readme",
  "keywords": [
    "x402",
    "base",
    "solana",
    "arbitrum",
    "ai-agents",
    "mcp",
    "monetization",
    "langchain"
  ],
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@warppay402/server": "^1.2.5",
    "bs58": "^6.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "openclaw": {
    "compat": {
      "pluginApi": "1.0.0"
    },
    "build": {
      "openclawVersion": "1.0.0"
    },
    "extensions": [
      "dist/index.js"
    ],
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateKey": {
          "type": "string",
          "description": "Base/Arbitrum wallet private key for paying x402 micropayments"
        }
      }
    }
  }
}
